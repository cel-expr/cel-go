load("@io_bazel_rules_go//go:def.bzl", "go_test")
load(":env_conformance_test.bzl", "cel_env_conformance_test")

package(
    licenses = ["notice"],  # Apache 2.0
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = ["env_conformance_test.go"],
    tags = [
        "manual",
        "notap",
    ],
    deps = [
        "//cel:go_default_library",
        "//common/env:go_default_library",
        "//common/types:go_default_library",
        "//common/types/ref:go_default_library",
        "//ext:go_default_library",
        "@cel_conformance//proto/cel/expr/conformance/test/env:suite_go_proto",
        "@com_github_google_go_cmp//cmp:go_default_library",
        "@dev_cel_expr//:expr",
        "@dev_cel_expr//conformance/test:go_default_library",
        "@in_yaml_go_yaml_v3//:go_default_library",
        "@io_bazel_rules_go//go/runfiles",
        "@org_golang_google_protobuf//encoding/prototext:go_default_library",
        "@org_golang_google_protobuf//proto:go_default_library",
        "@org_golang_google_protobuf//testing/protocmp:go_default_library",
    ],
)

_ALL_TESTS = [
    "@cel_conformance//tests/env:testdata/type_signatures.textproto",
]

_TESTS_TO_SKIP = [
    # Skip until cel-go normalizes well-known protobuf type aliases on YAML export.
    "type_signatures/timestamp/timestamp_alias",

    # Skip until env conformance error expectations are aligned across implementations.
    "type_signatures/errors/unterminated_map,duplicate_type_key",
]

cel_env_conformance_test(
    name = "env_conformance_test",
    skip_tests = _TESTS_TO_SKIP,
    test_files = _ALL_TESTS,
)
