# proto-file: internal/typedef/typedefpb/typedef.proto
# proto-message: cel.types.TypeDefSet
#
# Ported from cel-cpp common/typedef/testdata/cel_types.txtproto, omitting the
# unspec_prim_f, unspec_w_f, and unspec_wk_f fields: cel-go rejects unspecified
# primitive, wrapper, and well-known types.

# Minimal struct and enum (name only)
types {
  struct_type {
    name: "MinimalStruct"
  }
}
types {
  enum_type {
    name: "MinimalEnum"
  }
}

# Struct with name and doc
types {
  struct_type {
    name: "NoFields"
    doc: "Empty struct."
  }
}

# Enum with constants and doc
types {
  enum_type {
    name: "com.example.OrderStatus"
    doc: "Order lifecycle state."
    constants { name: "UNSPECIFIED" id: 0 doc: "Default value." }
    constants { name: "PENDING" id: 1 }
    constants { name: "SHIPPED" id: 10 doc: "Shipped to customer." }
  }
}

# Struct with fields
types {
  struct_type {
    name: "com.example.store.Order"
    fields {
      name: "items"
      type {
        list_type {
          elem_type {
            abstract_type { name: "com.example.store.Item" }
          }
        }
      }
    }
    fields {
      name: "metadata"
      type {
        map_type {
          key_type { primitive: STRING }
          value_type { dyn {} }
        }
      }
    }
    fields {
      name: "notes"
      type { wrapper: STRING }
    }
  }
}

# All supported field types
types {
  struct_type {
    name: "AllSupportedFieldTypes"
    fields {
      name: "null_field"
      type { null: NULL_VALUE }
      default_value { null_value: NULL_VALUE }
    }
    fields {
      name: "bool_field"
      type { primitive: BOOL }
      default_value { bool_value: true }
    }
    fields {
      name: "int_field"
      type { primitive: INT64 }
      default_value { int64_value: 123 }
    }
    fields {
      name: "uint_field"
      type { primitive: UINT64 }
      default_value { uint64_value: 456 }
    }
    fields {
      name: "double_field"
      type { primitive: DOUBLE }
      default_value { double_value: 3.25 }
    }
    fields {
      name: "bytes_field"
      type { primitive: BYTES }
      default_value { bytes_value: "\001\002\003" }
    }
    fields {
      name: "string_field"
      type { primitive: STRING }
      default_value { string_value: "hello" }
    }
    fields {
      name: "duration_field"
      type { well_known: DURATION }
      default_value { duration_value { seconds: 10 } }
    }
    fields {
      name: "timestamp_field"
      type { well_known: TIMESTAMP }
      default_value { timestamp_value { seconds: 1791158400 } }
    }
    fields {
      name: "enum_field"
      type { abstract_type { name: "com.example.Status" } }
      default_value { string_value: "ACTIVE" }
    }
    fields {
      name: "struct_field"
      type {
        map_type {
          key_type { primitive: STRING }
          value_type { dyn {} }
        }
      }
    }
    fields {
      name: "list_value_field"
      type { list_type { elem_type { dyn {} } } }
    }
    fields {
      name: "any_field"
      type { well_known: ANY }
    }
    fields {
      name: "func_field"
      type {
        function {
          result_type { primitive: BOOL }
          arg_types { primitive: INT64 }
          arg_types { primitive: STRING }
        }
      }
    }
    fields {
      name: "type_param_f"
      type { type_param: "T" }
    }
    fields {
      name: "bool_w_f"
      type { wrapper: BOOL }
    }
    fields {
      name: "int_w_f"
      type { wrapper: INT64 }
    }
    fields {
      name: "uint_w_f"
      type { wrapper: UINT64 }
    }
    fields {
      name: "double_w_f"
      type { wrapper: DOUBLE }
    }
    fields {
      name: "bytes_w_f"
      type { wrapper: BYTES }
    }
    fields {
      name: "map_val_only_f"
      type {
        map_type {
          key_type {}
          value_type { primitive: INT64 }
        }
      }
    }
    fields {
      name: "type_int_f"
      type {
        type { primitive: INT64 }
      }
    }
    fields {
      name: "type_unspec_f"
      type {
        type {}
      }
    }
    fields {
      name: "abstract_params_f"
      type {
        abstract_type {
          name: "MyGeneric"
          parameter_types { primitive: INT64 }
        }
      }
    }
    fields {
      name: "shipping_addr"
      type {
        message_type: "com.example.Address"
      }
    }
    fields {
      name: "error_f"
      type { error {} }
    }
  }
}

# Struct and enum with aspects
types {
  struct_type {
    name: "com.example.AnnotatedOrder"
    doc: "Order with schema aspects."
    fields {
      name: "order_id"
      type { primitive: STRING }
      aspects {
        key: "proto"
        value {
          properties {
            key: "id"
            value { int64_value: 1 }
          }
          properties {
            key: "json_name"
            value { string_value: "orderId" }
          }
          properties {
            key: "name"
            value { string_value: "order_id_proto" }
          }
        }
      }
    }
    fields {
      name: "empty_aspect_field"
      type { primitive: INT64 }
      aspects {
        key: "proto"
        value {}
      }
    }
    aspects {
      key: "proto"
      value {
        properties {
          key: "name"
          value { string_value: "com.example.proto.Order" }
        }
      }
    }
  }
}
types {
  enum_type {
    name: "com.example.AnnotatedStatus"
    constants {
      name: "STATUS_ACTIVE"
      id: 1
      aspects {
        key: "proto"
        value {
          properties {
            key: "name"
            value { string_value: "ACTIVE" }
          }
        }
      }
    }
    aspects {
      key: "proto"
      value {
        properties {
          key: "allow_alias"
          value { bool_value: true }
        }
        properties {
          key: "name"
          value { string_value: "com.example.proto.Status" }
        }
      }
    }
  }
}
